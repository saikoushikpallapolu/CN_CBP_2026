# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw PCAPs are tracked via Git LFS (see .gitattributes). Folder layout stays categorized.
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep
!data/raw/README.md
!data/raw/**/README.md
!data/raw/**/*.pcap

# Models & training outputs
ml/checkpoints/**
ml/runs/**
!ml/checkpoints/.gitkeep
!ml/runs/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Secrets / local config
.env
*.pem
credentials.json
